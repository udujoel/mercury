<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Mercury</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MERCURY_API_TOKEN</key>
	<string>$(MERCURY_API_TOKEN)</string>
	<key>API_BASE_URL</key>
	<string>$(API_BASE_URL)</string>

	<!-- Background audio playback: required so briefing audio keeps playing
	     (and stays controllable via MPRemoteCommandCenter) when the app is
	     backgrounded or the screen is locked. See ADR-005 and
	     Core/Audio/PlaybackCoordinator.swift. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- BGProcessingTask identifier reserved for the Phase 1 prefetch path
	     (PRD 3.6). Not yet scheduled from app code in this pass — the
	     identifier is declared here so it is stable from day one. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.joeludu.mercury.prefetch</string>
	</array>

	<!-- Local dev backend runs over plain HTTP on localhost; this does not
	     relax ATS for any other host. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>

	<key>UILaunchScreen</key>
	<dict/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
</dict>
</plist>
