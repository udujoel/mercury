// API_BASE_URL points the client at the FastAPI backend.
// If unset or malformed, the client falls back to http://localhost:8000
// (see Core/Networking/Endpoints.swift).
//
// SET THE SCHEME AND HOST SEPARATELY. Do not paste a full URL.
//
// xcconfig treats "//" as a comment delimiter anywhere on a line, so
//     API_BASE_URL = https://example.com
// silently becomes "https:" — everything from "//" onward is eaten. That
// still parses as a URL, so nothing errors; requests just go nowhere.
// Pasting a full URL into the assembled form below is worse: it yields
// "http://https://example.com", which truncates to "http://https:".
//
// Splitting scheme and host means no "//" ever appears in a value.
//
//   localhost (simulator):   API_SCHEME = http    API_HOST = localhost:8000
//   cloudflared tunnel:      API_SCHEME = https   API_HOST = <name>.trycloudflare.com
//   physical device on LAN:  use a tunnel, not an IP — App Transport Security
//                            blocks plain http to anything but localhost.

SLASH = /
API_SCHEME = http
API_HOST = localhost:8000
API_BASE_URL = $(API_SCHEME):$(SLASH)$(SLASH)$(API_HOST)
