// Copy this file to Secrets.xcconfig (gitignored) in the same directory.
// Same pattern as ios/Spikes/OAuthSpike/Secrets.example.xcconfig.
//
// API_BASE_URL points the client at the FastAPI backend. If unset, the client
// falls back to http://localhost:8000 — see Core/Networking/Endpoints.swift.
//
// NOTE THE SLASH DANCE BELOW, IT IS NOT DECORATION.
// xcconfig treats "//" as a comment delimiter, anywhere on a line. Writing
//     API_BASE_URL = http://localhost:8000
// silently truncates the value to "http:" — everything from "//" onward is
// eaten. That parses as a valid URL with no host, so nothing errors: requests
// just go to http://briefing/generate and fail DNS resolution at runtime.
// Splitting the slashes through a variable is the standard workaround.

SLASH = /
API_BASE_URL = http:$(SLASH)$(SLASH)localhost:8000
