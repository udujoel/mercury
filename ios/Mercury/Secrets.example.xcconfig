// Copy this file to Secrets.xcconfig (gitignored) in the same directory.
// Same pattern as ios/Spikes/OAuthSpike/Secrets.example.xcconfig.
//
// API_BASE_URL points the client at the FastAPI backend. Defaults to the
// local dev server if left unset — see Core/Networking/Endpoints.swift,
// which falls back to http://localhost:8000 when this key is empty.

API_BASE_URL = http://localhost:8000
