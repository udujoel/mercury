// Copy this file to Secrets.xcconfig (gitignored) in the same directory and
// fill in the real value. Secrets.xcconfig is never committed.
//
// GOOGLE_IOS_CLIENT_ID comes from Google Cloud Console:
//   APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
//   -> Application type: iOS -> Bundle ID: com.joeludu.mercury.oauthspike
// It looks like: 123456789012-abc123def456.apps.googleusercontent.com
//
// The app derives the ASWebAuthenticationSession callback scheme from this
// value automatically (reverse-DNS of the part before
// ".apps.googleusercontent.com") — you do not need to set it separately.

GOOGLE_IOS_CLIENT_ID = YOUR_IOS_CLIENT_ID_HERE.apps.googleusercontent.com
