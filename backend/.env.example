# ── LLM ───────────────────────────────────────────────────────
# Free key from https://aistudio.google.com
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# ── TTS ───────────────────────────────────────────────────────
# "google" (1M free chars/month) | "elevenlabs" | "openai"
TTS_PROVIDER=google
GOOGLE_TTS_CREDENTIALS=./credentials/gcp-tts.json
TTS_VOICE_HOST_A=en-US-Neural2-D
TTS_VOICE_HOST_B=en-US-Neural2-F
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_A=
ELEVENLABS_VOICE_B=

# ── Google OAuth (Gmail + Calendar) ───────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── Optional sources ──────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
REDDIT_USER_AGENT=mercury/0.1

# ── App config ────────────────────────────────────────────────
USER_NAME=Joel
USER_EMAIL=
USER_TIMEZONE=Europe/Lisbon
USER_LAT=40.6405
USER_LON=-8.6538
WAKE_TIME=07:00
BRIEFING_LENGTH=standard
HOST_A_NAME=Mara
HOST_B_NAME=Theo

# ── API auth (required) ──────────────────────────────────────
# The briefing endpoints refuse to serve without this. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MERCURY_API_TOKEN=

# ── Runtime ───────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./mercury.db
AUDIO_OUTPUT_DIR=./out
LOG_LEVEL=INFO

# ── APNs (silent push "briefing is ready" hint) ───────────────
# See docs/phase2/automation.md for the exact steps to create these.
APNS_KEY_PATH=./credentials/apns-auth-key.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_USE_SANDBOX=true

# ── Scheduler ─────────────────────────────────────────────────
# Off by default — tests and local dev must not schedule real generation.
SCHEDULER_ENABLED=false
GENERATION_LEAD_MINUTES=30
